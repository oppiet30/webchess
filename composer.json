{
    "name": "webchess/webchess",
    "description": "Plain-PHP chess web app (2013 original, 2026 modernization)",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "WebChess\\": "lib/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload-dev": {
        "psr-4": {
            "WebChess\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "bash scripts/lint-php.sh"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}